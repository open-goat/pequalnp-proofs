lemma index_of_mem_nat {a: ℕ} {w: List ℕ} (mem: a ∈ w): ∃ i,w.getD i 0 = a:= by
  obtain ⟨i,hi,e⟩:= List.mem_iff_getElem.mp mem
  exact ⟨i,by simpa [List.getD_eq_getElem?_getD,List.getElem?_eq_getElem hi] using e⟩
lemma runMonoDecode {R: ℕ → ℕ} {m T k t: ℕ} {S: Finset ℕ} (hl: Live R m T k t S): t = 0 →
    ∀ w: List ℕ,(∀ a ∈ S,a ∈ w) → ∃ (gs: List Gate) (o: ℕ),
      (∀ g ∈ gs,monotoneGate g) ∧ gs.length ≤ k ∧ (ex m gs w).getD o 0 = T:= by
  induction hl with
  | stop =>
    intro _ w hw
    obtain ⟨i,h⟩:= index_of_mem_nat (hw T (by simp))
    exact ⟨[],i,by simp,by simp,h⟩
  | un _ _ => intro h; omega
  | @bi k t d a b U hab hal run ih =>
    intro ht w hw
    obtain ⟨ia,ha⟩:= index_of_mem_nat (hw a (by simp))
    obtain ⟨ib,hb⟩:= index_of_mem_nat (hw b (by simp))
    let g: Gate:= ⟨if d then .or else .and,[ia,ib]⟩
    have ge: gv m w g = op d a b:= by
      cases d <;> first | exact congrArg₂ Nat.land ha hb | exact congrArg₂ Nat.lor ha hb
    have gm: monotoneGate g:= by cases d <;> simp [g,monotoneGate]
    obtain ⟨gs,o,hg,hk,ho⟩:= ih ht (w ++ [gv m w g]) (by
      intro c hc
      rcases Finset.mem_insert.1 hc with rfl | hc
      · exact List.mem_append_right _ (by simp [ge])
      · exact List.mem_append_left _ (hw c (by simp [hc])))
    exact ⟨g::gs,o,by intro u hu; exact (List.mem_cons.1 hu).elim (fun h => h ▸ gm) (hg u),by simp; omega,ho⟩

lemma scanOff {p: X → Bool} {v: List X} (h: ∀ a ∈ v,p a = false): scan p v = false:= by
  induction v with
  | nil => rfl
  | cons a t ih =>
    change (Bool.rec (motive:= fun _ => Bool) (scan p t) true (p a): Bool) = false
    rw [h a List.mem_cons_self]
    exact ih fun b hb => h b (List.mem_cons_of_mem _ hb)
lemma allPairsOff {h: X → X → Bool} {v: List X} (hw: v.Pairwise (fun a b => h a b = false)): pairs h v = false:= by
  induction v with
  | nil => rfl
  | cons a t ih =>
    obtain ⟨hd,tl⟩:= List.pairwise_cons.1 hw
    change (Bool.rec (motive:= fun _ => Bool) (pairs h t) true (scan (h a) t): Bool) = false
    rw [scanOff hd]; exact ih tl
lemma groupCover {L: List (ℕ × ℕ)} (full: mFull L = true) {h: X → X → Bool} {v: List X}
    (cut: ∀ p ∈ L,pairsC p.1 h v = false): pairs h v = false:= by
  simp only [mFull,Bool.and_eq_true,List.all_eq_true,List.mem_range,List.any_eq_true] at full
  apply allPairsOff
  have aux: ∀ ws: List X,(∀ p ∈ L,ws.Pairwise (fun a b => hb p.1 (a.s + b.s) = true → h a b = false)) → ws.Pairwise (fun a b => h a b = false):= by
    intro ws; induction ws with
    | nil => intro _; exact .nil
    | cons a t ih =>
      intro hs; apply List.pairwise_cons.2; constructor
      · intro b hb'
        obtain ⟨p,hp,bit⟩:= full.1 ((a.s + b.s) % MM) (Nat.mod_lt _ (by decide))
        exact (List.pairwise_cons.1 (hs p hp)).1 b hb' ((hb_mod p.1 (a.s + b.s)).trans bit)
      · exact ih fun p hp => (List.pairwise_cons.1 (hs p hp)).2
  exact aux v (fun p hp => pairsC_false (cut p hp))
lemma nodeCover {L: List (ℕ × ℕ)} (full: mFull L = true) (fn: ℕ → List W → Bool) (d: Bool) (l m g e n z: ℕ) (v: List W)
    (hs: ∀ p ∈ L,node fn d l m g e n z v (fun h xs => pairsC p.1 h (fs xs)) = false): node fn d l m g e n z v pairsS = false:= by
  cases hn: Nat.ble n e <;> simp only [node,hn,bR,Bool.cond_false,Bool.cond_true,pairsS] at hs ⊢ <;> exact groupCover full hs
lemma testForm (d: Bool) (l e: ℕ) (v: List W): (∀ f,tst d l e v f = false) ∨ ∃ y,∀ f,tst d l e v f = f y:= by
  unfold tst tstCore
  beta_reduce
  cases Nat.beq (cov d l v) l <;> cases Nat.beq v.length e <;> cases Nat.beq (Nat.succ v.length) e <;> cases rect d l (wst d l v) v [] <;> cases bip l (wst d l v) v [] <;> cases flk l (wst d l v) v star <;>
    first | exact Or.inl (fun _ => rfl) | exact Or.inr ⟨0,fun _ => rfl⟩ | exact Or.inr ⟨1,fun _ => rfl⟩
noncomputable def capC (l m g K fu H ph k t z: ℕ) (v: List W): Bool :=
  bif Nat.ble v.length 1 then true else tst (pos t) l (k+1-t) v (fun y =>
    node (look1 l m g K fu (k-1) t) (pos t) l m g (k-t-y) v.length z v (fun h xs => pairsC H h (fs xs)) ||
    (Nat.beq ph 1 && mv (look l m g K) l m g k t z v y))
lemma capCombine {L: List (ℕ × ℕ)} (full: mFull L = true) {l m g K fu k t z: ℕ} {v: List W}
    (tests: ∀ p ∈ L,capC l m g K fu p.1 p.2 k t z v = false): look1 l m g K (fu+1) k t z v = false:= by
  have ph:= full
  simp only [mFull,Bool.and_eq_true,List.any_eq_true] at ph
  obtain ⟨p,hp,hph⟩:= ph.2
  rw [lookCapStep]
  cases hn: Nat.ble v.length 1 with
  | true => simpa only [capC,hn,Bool.cond_true] using tests p hp
  | false =>
    rw [Bool.cond_false]
    rcases testForm (pos t) l (k+1-t) v with h | ⟨y,h⟩
    · exact h _
    · rw [h]
      have cut (q) (hq: q ∈ L):= tests q hq
      simp only [capC,hn,Bool.cond_false,h,Bool.or_eq_false_iff] at cut
      have hd:= nodeCover full _ _ _ _ _ _ _ _ _ (fun u hu => (cut u hu).1)
      have tl:= (cut p hp).2
      rw [hph,Bool.true_and] at tl
      rw [hd,tl]; rfl
noncomputable def cInner (l m g H ph z: ℕ) (v: List W): Bool:= bif Nat.ble v.length 1 then true else tst (pos 1) l (12+1-1) v (fun y => node reuse3 (pos 1) l m g (12-1-y) v.length z v (fun h xs => pairsC H h (fs xs)) || (Nat.beq ph 1 && mv (look l m g 14) l m g 12 1 z v y))
lemma cInner_ok (H ph z: ℕ) (v: List W): cInner (lz 0) (mz 0) cfgG H ph z v = capC (lz 0) (mz 0) cfgG 14 12 H ph 12 1 z v:= by
  unfold cInner
  rw [reuse3_eq]
  rfl
noncomputable def dCap (p: ℕ × List W) (u v: ℕ):= st scN0 fun l => st scN1 fun m => st scN2 fun g => st p.1 fun z => frc p.2 fun r => cInner l m g u v z r
lemma dRule {p: ℕ × List W} {L: List (ℕ × ℕ)} (a: mFull L = true) (b: ∀ q ∈ L,dCap p q.1 q.2 = false): nextF p.1 p.2 = false:= by
  apply capCombine a
  intro q hq
  simpa only [dCap,st_eq,frc_eq,gridLiteral.1,gridLiteral.2.1,gridLiteral.2.2,cInner_ok] using b q hq

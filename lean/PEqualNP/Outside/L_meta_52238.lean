lemma monoOfLive13 {S: Finset ℕ} (sub: (S: Set ℕ) ⊆ C (mz 0) (WZ [] 0))
    (live: Live Z0 (mz 0) (tz 0) 13 0 S): MonoFourteen:= by
  have incl: C (mz 0) (S: Set ℕ) ⊆ C (mz 0) (WZ [] 0):= by
    rintro a (ha|ha); exact sub ha; exact Or.inr ha
  have hm: Min Z0 (mz 0) (tz 0) 13 0 S:= ⟨live,fun q hq h => floorRoot q hq (h.mono le_rfl incl)⟩
  have bd: ∀ x ∈ S,x &&& mz 0 = x:= by
    intro a ha; rcases sub ha with ⟨w,_,rfl⟩ | he
    · rw [Nat.and_assoc,Nat.and_self]
    · simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at he; rcases he with rfl | rfl; exact Nat.zero_and _; exact Nat.and_self _
  have e: tz 0 &&& mz 0 = tz 0:= by change (TG &&& mz 0) &&& mz 0 = TG &&& mz 0; rw [Nat.and_assoc,Nat.and_self]
  obtain ⟨h0,h1⟩:= hm.proper e (by decide +kernel) (by decide +kernel) bd
  have sw: ∀ a ∈ S,a ∈ rawP.map (· &&& mz 0):= by
    intro a ha
    rcases sub ha with ⟨w,hw,rfl⟩ | hh
    · exact List.mem_map.2 ⟨w,by simpa [rawL] using hw,rfl⟩
    · simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hh; rcases hh with rfl | rfl; exact (h0 ha).elim; exact (h1 ha).elim
  obtain ⟨gs,o,hw,hk,ho⟩:= runMonoDecode live rfl _ sw
  exact ⟨gs,o,hw,by omega,physicalFromRaw hw ho⟩

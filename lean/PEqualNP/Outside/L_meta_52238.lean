def edgePairs: List ℕ:= [0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]

def goal (x: Fin 8 → Bool): Bool :=
  decide (∃ i < edgePairs.length / 2,
    (List.ofFn x).getD (edgePairs.getD (2 * i) 0) false = true ∧
    (List.ofFn x).getD (edgePairs.getD (2 * i + 1) 0) false = true)

def monotoneGate (g: Gate): Prop:= (g.op = .and ∨ g.op = .or) ∧ g.inputs.length ≤ 2
def computes (C: Circuit): Prop:= ∀ x: Fin 8 → Bool,C.eval (List.ofFn x) = goal x

def upper: Circuit:= ⟨[⟨.or,[5,7]⟩,⟨.or,[1,7]⟩,⟨.or,[4,6]⟩,⟨.or,[0,6]⟩,⟨.or,[0,2]⟩,⟨.or,[0,1]⟩,⟨.or,[10,7]⟩,⟨.or,[13,3]⟩,⟨.and,[8,15]⟩,⟨.and,[14,12]⟩,⟨.and,[11,3]⟩,⟨.and,[9,4]⟩,⟨.or,[16,17]⟩,⟨.or,[18,19]⟩,⟨.or,[20,21]⟩],22⟩

theorem upper_legal: ∀ g ∈ upper.gates,monotoneGate g:= by
  simp [upper,monotoneGate]


theorem exact_of_deep (hd: DeepChecks): (∀ (gates: List PEqualNP.CircuitLowerBounds.Gate) (o: ℕ),(∀ g ∈ gates,(g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.not) ∧ g.inputs.length ≤ 2) → (∀ i j: Fin gates.length,(gates.get i).op = PEqualNP.CircuitLowerBounds.GateOp.not → (gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not → i = j) → (∀ x: Fin 8 → Bool,PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates,o⟩ (List.ofFn x) = decide (∃ i < ([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).length / 2,(List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i + 1) 0) false = true)) → ∃ (gates': List PEqualNP.CircuitLowerBounds.Gate) (o': ℕ),(∀ g ∈ gates',(g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length ≤ 2) ∧ gates'.length ≤ gates.length ∧ ∀ x: Fin 8 → Bool,PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates',o'⟩ (List.ofFn x) = decide (∃ i < ([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).length / 2,(List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i + 1) 0) false = true)):= by

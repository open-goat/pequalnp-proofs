lemma shortSigned: chk [] paidDeck 0 13 1 FF 1 = false:= by decide +kernel
lemma signedPhysical14 (gs: List Gate) (o: ℕ) (fan: FanInTwo ⟨gs,o⟩)
    (pw: gs.Pairwise (fun a b => a.op = GateOp.not → b.op ≠ GateOp.not))
    (neg: ∃ a ∈ gs,a.op = GateOp.not) (hc: computes ⟨gs,o⟩): 14 ≤ gs.length:= by
  have low:= fullPhysicalFloor gs o fan hc
  by_contra ht
  have eq: gs.length = 13:= by omega
  obtain d | ⟨S,hS,run⟩:= bridge_one gs o fan pw neg (fun x => (hc x).trans (goalF x))
  · exact floorRoot _ (by omega) d
  · rw [eq] at run
    exact imp_of_live (L:= 14) (Or.inl rfl) paidOK (by decide) signedDeckOK (by decide) hS run floorRoot (Or.inr (one1 shortSigned))

def SignedFit (gs: List Gate): Prop:= ∀ g ∈ gs,(g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not) ∧ g.inputs.length ≤ 2
def UniqueNeg (gs: List Gate): Prop:= ∀ i j: Fin gs.length,(gs.get i).op = GateOp.not → (gs.get j).op = GateOp.not → i = j
def SignedFourteen: Prop:= ∃ (gs: List Gate) (o: ℕ),gs.length = 14 ∧ SignedFit gs ∧ UniqueNeg gs ∧ (∃ g ∈ gs,g.op = GateOp.not) ∧ computes ⟨gs,o⟩
def MonoFourteen: Prop:= ∃ (gs: List Gate) (o: ℕ),(∀ g ∈ gs,monotoneGate g) ∧ gs.length ≤ 14 ∧ computes ⟨gs,o⟩
theorem reduced_iff: (∀ (gates: List PEqualNP.CircuitLowerBounds.Gate) (o: ℕ),(∀ g ∈ gates,(g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.not) ∧ g.inputs.length ≤ 2) → (∀ i j: Fin gates.length,(gates.get i).op = PEqualNP.CircuitLowerBounds.GateOp.not → (gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not → i = j) → (∀ x: Fin 8 → Bool,PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates,o⟩ (List.ofFn x) = decide (∃ i < ([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).length / 2,(List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i + 1) 0) false = true)) → ∃ (gates': List PEqualNP.CircuitLowerBounds.Gate) (o': ℕ),(∀ g ∈ gates',(g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length ≤ 2) ∧ gates'.length ≤ gates.length ∧ ∀ x: Fin 8 → Bool,PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates',o'⟩ (List.ofFn x) = decide (∃ i < ([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).length / 2,(List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0,3,0,4,1,4,2,4,0,5,1,5,3,5,0,6,2,6,3,6,0,7,1,7,2,7,3,7,4,7]: List ℕ).getD (2 * i + 1) 0) false = true)) ↔ (MonoFourteen ∨ ¬ SignedFourteen):= by
  constructor
  · intro h
    by_cases hs: SignedFourteen
    · obtain ⟨gs,o,hlen,hf,hu,_,hc⟩:= hs
      obtain ⟨gs',o',hm,hle,hc'⟩:= h gs o hf hu hc
      exact Or.inl ⟨gs',o',hm,hlen ▸ hle,hc'⟩
    · exact Or.inr hs
  · intro h gs o hf hu hc
    by_cases neg: ∃ g ∈ gs,g.op = GateOp.not
    · have hp: gs.Pairwise (fun a b => a.op = GateOp.not → b.op ≠ GateOp.not) :=
        List.pairwise_iff_get.2 fun i j hij ai aj => (Fin.ne_of_lt hij) (hu i j ai aj)
      have lo:= signedPhysical14 gs o (fanInTwo_of hf) hp neg hc
      by_cases hi: 15 ≤ gs.length
      · exact upper_dominates ⟨gs,o⟩ hi
      · have he: gs.length = 14:= by omega
        rcases h with ⟨as,p,hm,hl,ha⟩ | hexc
        · exact ⟨as,p,hm,he.symm ▸ hl,ha⟩
        · exact (hexc ⟨gs,o,he,hf,hu,neg,hc⟩).elim
    · refine ⟨gs,o,?_,le_rfl,hc⟩
      intro g hg
      obtain ⟨op,len⟩:= hf g hg
      exact ⟨op.imp_right (fun v => v.resolve_right (fun hn => neg ⟨g,hg,hn⟩)),len⟩

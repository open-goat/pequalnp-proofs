    n ≤ binaryCost C.gates := by
  have hleg : ∀ g ∈ C.gates, legal g := by
    intro g hg
    obtain ⟨hop, hlen⟩ := hfan g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
    exact ⟨hop, hlen⟩
  obtain ⟨vs, hvlen, hvbd, hvhit⟩ := compileBin_aux C.gates hleg rawVars rootStock rawVars_avail
  set finalW := C.gates.foldl (fun acc g => acc ++ [actionWord acc g]) rawVars
  have hout_eq : finalW.getD C.output 0 &&& fullMask = target &&& fullMask := by
    apply Nat.eq_of_testBit_eq; intro k
    by_cases hk : k < 64
    · have hfm := fullMask_bit hk
      simp only [Nat.testBit_and, hfm, Bool.and_true]
      let x : Fin 6 → Bool := fun i => k.testBit i.val
      have hxidx : (∑ i : Fin 6, if x i then 2 ^ (i : Nat) else 0) = k := sum_bits_6 k hk
      have h1 := hC x
      rw [hxidx, rawVars_ofFn x, hxidx] at h1
      change (C.gates.foldl stepBool (rawVars.map (evalBit k))).getD C.output false = target.testBit k at h1
      rw [foldl_evalBit C.gates hleg rawVars hk, readBit] at h1
      exact h1
    · have hfm0 : fullMask.testBit k = false := by
        rw [fullMask_eq, Nat.testBit_two_pow_sub_one]; simp [hk]
      simp [Nat.testBit_and, hfm0]
  have hout_avail : Avail (vs ++ rootStock) (canon fullMask target) := by
    rw [← canon_land fullMask target, ← hout_eq, canon_land]
    by_cases hi : C.output < finalW.length
    · exact hvhit _ (by simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi])
    · rw [List.getD_eq_default _ _ (Nat.le_of_not_gt hi), canon_zero]; exact Or.inl rfl
  exact (hlow vs hvbd hout_avail).trans hvlen

def countedNots (gs : List Gate) : Nat := (gs.filter (fun g => !isBinary g)).length

theorem counts_split (gs : List Gate) : binaryCost gs + countedNots gs = gs.length := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    cases h : isBinary g <;> simp [binaryCost, countedNots, List.filter, h] at ih ⊢ <;> omega

theorem from_exactly_one (target m : Nat)
    (hlow : LowerBin fullMask rootStock (canon fullMask target) (m - 2))
    (hone : ∀ C : Circuit, FanInTwo C →
      (∀ x : Fin 6 → Bool, C.eval (List.ofFn x) =
        Nat.testBit target (∑ i : Fin 6, if x i then 2 ^ (i : Nat) else 0)) →
        countedNots C.gates = 1 → m ≤ C.size)
    (wg : List Gate) (wout : Nat) (hsz : wg.length = m) (hmono : Monotone2 ⟨wg,wout⟩)
    (heval : ∀ x : Fin 6 → Bool, Circuit.eval ⟨wg,wout⟩ (List.ofFn x) =
      Nat.testBit target (∑ i : Fin 6, if x i then 2 ^ (i : Nat) else 0)) :
    ∀ s : Nat, HasCircuitSize 6 (fun x : Fin 6 → Bool =>
      Nat.testBit target (∑ i : Fin 6, if x i then 2 ^ (i : Nat) else 0)) s →
    ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool,
      C.eval (List.ofFn x) = Nat.testBit target (∑ i : Fin 6, if x i then 2 ^ (i : Nat) else 0) := by
  intro s ⟨C, hfan, hsize, hC⟩
  by_cases hn : ∃ g ∈ C.gates, g.op = GateOp.not
  · refine ⟨⟨wg,wout⟩, hmono, ?_, heval⟩
    change wg.length ≤ s
    rw [hsz]
    obtain ⟨g, hg, hgnot⟩ := hn
    have hlt : binaryCost C.gates < C.gates.length :=
      (List.length_filter_lt_length_iff_exists (p := isBinary)).mpr
        ⟨g, hg, by simp [isBinary, hgnot]⟩
    have hcount := counts_split C.gates
    by_cases h1 : countedNots C.gates = 1
    · exact (hone C hfan hC h1).trans hsize
    · have hbound := signed_binary_count hlow hfan hC
      change C.gates.length ≤ s at hsize
      omega
  · refine ⟨C, ?_, hsize, hC⟩
    intro g hg
    obtain ⟨hop, hlen⟩ := hfan g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop ⊢
    refine ⟨?_, hlen⟩
    rcases hop with h | h | h
    · exact Or.inl h
    · exact Or.inr h
    · exact (hn ⟨g, hg, h⟩).elim


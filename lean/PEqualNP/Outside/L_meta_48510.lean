lemma exStepsBalanced (m T : ℕ) (gs : List Gate) : ∀ (w : List ℕ) (S : Set ℕ),
    (∀ x ∈ w, x ∈ S) → 0 ∈ S → m ∈ S →
    (∀ g ∈ gs, g.op ∈ ({GateOp.and,GateOp.or,GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) →
    (∃ i, (ex m gs w).getD i 0 = T) →
    ∃ k u, k ≤ gs.length ∧ u ≤ countNot gs ∧ k + countNot gs ≤ gs.length + u ∧ Steps m T k u S := by
  induction gs with
  | nil =>
    rintro w S hw h0 _ _ ⟨i,rfl⟩
    exact ⟨0,0,le_rfl,le_rfl,le_rfl,.done (getD_mem hw h0 i)⟩
  | cons g gs ih =>
    intro w S hw h0 hm hg hT
    have hgs := fun x hx => hg x (List.mem_cons_of_mem _ hx)
    have rd := fun i => getD_mem hw h0 i
    have stay : gv m w g ∈ S → ∃ k u, k ≤ (g::gs).length ∧ u ≤ countNot (g::gs) ∧ k + countNot (g::gs) ≤ (g::gs).length + u ∧ Steps m T k u S := by
      intro h
      obtain ⟨k,u,hk,hu,balance,st⟩ := ih (w ++ [gv m w g]) S (fun x hx => by
        simp only [List.mem_append,List.mem_singleton] at hx
        exact hx.elim (hw x) (fun e => e ▸ h)) h0 hm hgs hT
      exact ⟨k,u,by simp; omega,by simp only [countNot]; omega,by simp only [countNot, List.length_cons]; split <;> omega,st⟩
    obtain ⟨k,u,hk,hu,balance,go⟩ := ih (w ++ [gv m w g]) (insert (gv m w g) S) (fun x hx => by
      simp only [List.mem_append,List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact Or.inr (hw x hx)
      · exact Or.inl rfl) (Or.inr h0) (Or.inr hm) hgs hT
    obtain ⟨hop,_⟩ := hg g List.mem_cons_self
    obtain ⟨o,l⟩ := g
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hop
    rcases hop with rfl | rfl | rfl
    · match l with
      | [] => exact stay hm
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact ⟨k+1,u,by simpa using hk,by simpa [countNot] using hu,by simp [countNot]; omega,.bi (d := false) (rd i) (rd j) go⟩
    · match l with
      | [] => exact stay h0
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact ⟨k+1,u,by simpa using hk,by simpa [countNot] using hu,by simp [countNot]; omega,.bi (d := true) (rd i) (rd j) go⟩
    · match l with
      | [] => exact stay hm
      | i :: _ => exact ⟨k+1,u+1,by simpa using hk,by simp [countNot]; omega,by simp [countNot]; omega,.un (rd i) go⟩


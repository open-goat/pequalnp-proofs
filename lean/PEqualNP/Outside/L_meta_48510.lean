lemma gradeBatch {before floors checks : List (ℕ × ℕ)}
    (small : checks.all (containsWeakerFloor floors) = true)
    (floored : ∀ e ∈ floors, Imp [] e.1 e.2)
    (prior : ∀ e ∈ before, HasGrade 1 e)
    (verified : checks.all (gradeTest 1 before) = true) :
    ∀ e ∈ checks, HasGrade 1 e := by
  intro e he
  obtain ⟨r, hr, test⟩ := List.any_eq_true.mp (List.all_eq_true.mp small e he)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at test
  have heq : e.1 = r.1 := test.1
  have hle : e.2 ≤ r.2 := test.2
  have floor : Imp [] e.1 e.2 := by
    rw [heq]
    intro q hq
    exact floored r hr q (Nat.lt_of_lt_of_le hq hle)
  simpa only [gradeOneRow] using
    checkedGrade (t := 1) (before := before) (e := e) floor
      (fun r hr => by simpa only [gradeOneRow] using prior r hr)
      (List.all_eq_true.mp verified e he)


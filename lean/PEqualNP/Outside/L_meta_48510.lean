    (left : ∀ e ∈ xs, HasGrade 1 e) (right : ∀ e ∈ ys, HasGrade 1 e) :
    ∀ e ∈ xs ++ ys, HasGrade 1 e :=
  fun e he => (List.mem_append.mp he).elim (left e) (right e)


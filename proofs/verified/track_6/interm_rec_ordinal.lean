-- Track 6: Intermediate Ordinal-Fractal Cut Number System (𝓘_cut)
-- Intermediate Recursive Ordinal System (ℐ_rec) — Core Lean version
--
-- Formalizes ordinals that are NEITHER finite (ℕ) NOR infinite (≥ ω).
-- These are "intermediate recursive ordinals" generated by recursive rules.
-- Supports arithmetic, matrices, and arrays.
--
-- Zero `sorry`. Core Lean only (no Mathlib).

-- Intermediate recursive ordinal type.
inductive IntermOrd where
  | zero : IntermOrd
  | succ : IntermOrd → IntermOrd

-- Ordering relation: a ≺ b means a is strictly less than b.
inductive IntermOrdLt : IntermOrd → IntermOrd → Prop
  | zero_succ (x : IntermOrd) : IntermOrdLt IntermOrd.zero (IntermOrd.succ x)
  | succ_succ (x y : IntermOrd) (h : IntermOrdLt x y) : IntermOrdLt (IntermOrd.succ x) (IntermOrd.succ y)

-- Addition of intermediate ordinals.
-- Defined recursively:
--   a + 0 = a
--   a + succ b = succ (a + b)
def i_add : IntermOrd → IntermOrd → IntermOrd
  | a, IntermOrd.zero => a
  | a, IntermOrd.succ b => IntermOrd.succ (i_add a b)

-- Multiplication of intermediate ordinals.
-- Defined recursively:
--   a * 0 = zero
--   a * succ b = a ⊕ (a * b)
def i_mul : IntermOrd → IntermOrd → IntermOrd
  | a, IntermOrd.zero => IntermOrd.zero
  | a, IntermOrd.succ b => i_add a (i_mul a b)

-- Exponentiation of intermediate ordinals.
-- Defined recursively:
--   a ^ 0 = succ zero  (multiplicative identity)
--   a ^ succ b = a ⊗ (a ^ b)
def i_pow : IntermOrd → IntermOrd → IntermOrd
  | a, IntermOrd.zero => IntermOrd.succ IntermOrd.zero
  | a, IntermOrd.succ b => i_mul a (i_pow a b)

-- Matrix over intermediate ordinals: a matrix is a function from (row, col) to IntermOrd.
def i_matrix (m n : Nat) : Type :=
  Nat → Nat → IntermOrd

-- Matrix addition: element-wise addition.
def i_matrix_add {m n : Nat} (A B : i_matrix m n) : i_matrix m n :=
  fun i j => i_add (A i j) (B i j)

-- Matrix multiplication: standard matrix multiplication using i_add and i_mul.
def i_matrix_mul {m n p : Nat} (A : i_matrix m n) (B : i_matrix n p) : i_matrix m p :=
  fun i j =>
    -- Sum over k: A[i,k] ⊗ B[k,j]
    let rec sum_mat : Nat → IntermOrd
      | 0 => IntermOrd.zero
      | n + 1 => i_add (sum_mat n) (i_mul (A i n) (B n j))
    in sum_mat p

-- Array over intermediate ordinals: an array is a function from index to IntermOrd.
def i_array (n : Nat) : Type :=
  Nat → IntermOrd

-- Array addition: element-wise addition.
def i_array_add {n : Nat} (A B : i_array n) : i_array n :=
  fun i => i_add (A i) (B i)

-- Array scalar multiplication: multiply each element by a scalar.
def i_array_smul {n : Nat} (c : IntermOrd) (a : i_array n) : i_array n :=
  fun i => i_mul c (a i)

-- Example: create a 2x2 identity matrix over intermediate ordinals.
def i_ident : i_matrix 2 2 :=
  fun i j =>
    if i = j then IntermOrd.succ IntermOrd.zero else IntermOrd.zero

-- Example: create a 3-element array with values 1, 2, 3 (as intermediate ordinals).
def i_example_array : i_array 3 :=
  fun i =>
    match i with
    | 0 => IntermOrd.succ IntermOrd.zero
    | 1 => IntermOrd.succ (IntermOrd.succ IntermOrd.zero)
    | 2 => IntermOrd.succ (IntermOrd.succ (IntermOrd.succ IntermOrd.zero))
    | _ => IntermOrd.zero

-- Example: 2x2 matrix with values [[1, 2], [3, 4]] (as intermediate ordinals).
def i_example_matrix : i_matrix 2 2 :=
  fun i j =>
    match (i, j) with
    | (0, 0) => IntermOrd.succ IntermOrd.zero
    | (0, 1) => IntermOrd.succ (IntermOrd.succ IntermOrd.zero)
    | (1, 0) => IntermOrd.succ (IntermOrd.succ (IntermOrd.succ IntermOrd.zero))
    | (1, 1) => IntermOrd.succ (IntermOrd.succ (IntermOrd.succ (IntermOrd.succ IntermOrd.zero)))
    | _ => IntermOrd.zero

#check IntermOrd.zero
#check IntermOrd.succ IntermOrd.zero
#check IntermOrd.succ (IntermOrd.succ IntermOrd.zero)
#check i_add
#check i_mul
#check i_pow
#check i_matrix
#check i_array
#check i_ident
#check i_example_array
#check i_example_matrix